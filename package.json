{
  "name": "baseball-playoffs",
  "private": true,
  "type": "module",
  "description": "The MLB postseason tracker page and its live-data connector. No runtime dependencies; dev tools only.",
  "license": "MIT",
  "engines": {
    "node": ">=22.21"
  },
  "scripts": {
    "test": "node worker/build.mjs --check && TZ=America/New_York node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:browser",
    "test:browser": "playwright test",
    "build": "node worker/build.mjs",
    "deploy": "node worker/build.mjs && npx wrangler deploy --config worker/wrangler.toml",
    "deploy:api": "npm test && NODE_USE_ENV_PROXY=1 node worker/deploy.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "prettier": {
    "printWidth": 100
  }
}
