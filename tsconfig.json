{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "types": ["node"],
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "strictBindCallApply": true,
    "useUnknownInCatchVariables": true
  },
  "include": ["page/js", "worker", "tests", "*.mjs", "types"],
  "exclude": ["page/js/sortable.min.js", "worker/dist", "tests/browser/runtime.js"]
}
