{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "apps/*/page/js/app.js",
    "apps/*/worker/src/index.js",
    "worker/*.mjs",
    "tests/*.test.js",
    "tests/browser/serve.mjs",
    "apps/*/tests/*.test.js",
    "apps/*/tests/browser/*.spec.mjs",
    "apps/*/tests/fixtures/record.js"
  ],
  "project": [
    "apps/*/page/js/**/*.js",
    "apps/*/worker/**/*.{js,mjs}",
    "apps/*/tests/**/*.{js,mjs}",
    "worker/**/*.{js,mjs}",
    "tests/**/*.{js,mjs}",
    "*.mjs"
  ],
  "ignore": ["apps/*/page/js/sortable.min.js"]
}
